# Puerto en el que corre el servidor Express
PORT=8080

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Cadena de conexión a la base de datos MongoDB (Desarrollo)
MONGODB_URI=mongodb://localhost:27017/shipnow

# Cadena de conexión separada para la base de datos de Testing (Pre-entrega 6)
MONGODB_URI_TEST=mongodb://localhost:27017/shipnow_test
